{
  "name": "crunch",
  "version": "1.3.0",
  "description": "Registrazione e trascrizione audio per lezioni universitarie con accelerazione Metal",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:electron": "node scripts/run-tests.mjs --electron",
    "test:e2e": "node scripts/run-tests.mjs --e2e",
    "test:updater": "node --test test/updater.test.js test/entitlements.test.js",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "prebuild": "rm -rf dist/mac-arm64 dist/*.dmg dist/*.zip dist/*.blockmap",
    "build": "npm run prebuild && npm run rebuild:native && electron-builder --mac && npm run postbuild",
    "postbuild": "touch dist/.metadata_never_index",
    "build:dir": "npm run prebuild && npm run rebuild:native && electron-builder --mac --dir && npm run postbuild",
    "clean:installers": "rm -f dist/*.dmg dist/*.zip dist/*.blockmap",
    "clean:dist": "rm -rf dist && mkdir -p dist && touch dist/.metadata_never_index",
    "build-whisper": "bash scripts/build-whisper.sh",
    "smoke-release": "bash scripts/smoke-release.sh",
    "benchmark-live": "node scripts/benchmark-live.mjs",
    "verify-releases": "bash scripts/verify-releases.sh",
    "verify-entitlements": "node scripts/verify-entitlements.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes",
    "release:prepare": "node scripts/release.mjs prepare",
    "sign-update": "node scripts/sign-update.mjs",
    "install:app": "rm -rf /Applications/Crunch.app && cp -R dist/mac-arm64/Crunch.app /Applications/ && echo 'Crunch installata con successo in /Applications/Crunch.app!'",
    "postinstall": "node scripts/rebuild-native.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IC3NBERG/Memo.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.crunch.app",
    "productName": "Crunch",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "IC3NBERG",
        "repo": "Memo",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Crunch ha bisogno del microfono per registrare le lezioni."
      }
    },
    "dmg": {
      "title": "Installa Crunch",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 370,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 500,
        "height": 340
      }
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
