{
  "name": "crunch",
  "version": "1.1.0",
  "description": "Registrazione e trascrizione audio per lezioni universitarie con accelerazione Metal",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron --test test/*.test.js",
    "rebuild:native": "bash scripts/rebuild-native.sh",
    "build": "npm run rebuild:native && electron-builder --mac",
    "build:dir": "npm run rebuild:native && electron-builder --mac --dir",
    "build-whisper": "bash scripts/build-whisper.sh",
    "benchmark-live": "node scripts/benchmark-live.mjs",
    "verify-releases": "bash scripts/verify-releases.sh",
    "install:app": "cp -R dist/mac-arm64/Crunch.app /Applications/ && echo 'Crunch installata con successo in /Applications/Crunch.app!'",
    "postinstall": "bash scripts/rebuild-native.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IC3NBERG/Memo.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.crunch.app",
    "productName": "Crunch",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "IC3NBERG",
        "repo": "Memo",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Crunch ha bisogno del microfono per registrare le lezioni."
      }
    },
    "dmg": {
      "title": "Installa Crunch",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 370,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 500,
        "height": 340
      }
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
