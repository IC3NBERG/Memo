{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crunch.app/schema/edits-v1.json",
  "title": "Crunch transcript edit overlay",
  "type": "object",
  "required": [
    "schemaVersion",
    "revisionId",
    "sourceHash",
    "editRevision",
    "segmentText",
    "hiddenSegmentIds",
    "tags",
    "annotations",
    "order",
    "groups"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revisionId": { "type": "string", "pattern": "^r[1-9][0-9]*$" },
    "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "editRevision": { "type": "integer", "minimum": 0 },
    "segmentText": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "hiddenSegmentIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "text", "createdAt"],
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "order": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "segmentIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "segmentIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "legacyDocumentText": {
      "type": "string",
      "description": "Solo compatibilità con l'editor contenteditable precedente. Deprecato."
    }
  },
  "additionalProperties": true
}
